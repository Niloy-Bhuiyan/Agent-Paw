# ============================================================
# AgentPaw — AI Companion environment variables
#
# Copy this file to `.env.local` in the project root (next to
# package.json) and fill in the keys you have. Every variable is
# optional: with no keys at all, the app runs fully on mock data.
# Adding a valid key activates that provider on the next request —
# no code changes, no rebuild in dev (restart `next dev` so the
# process picks up the new env).
#
# NEVER commit `.env.local` — it is gitignored via `.env*`.
# ============================================================

# ---- Provider selection ------------------------------------
# Which provider serves chats when the UI doesn't pick one.
# One of: anthropic | openai | google | mock
# Default: the first configured provider, else mock.
#AI_DEFAULT_PROVIDER=anthropic

# ---- Anthropic (Claude) ------------------------------------
# Get a key: https://platform.claude.com/
#ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-opus-4-8)
#ANTHROPIC_MODEL=claude-opus-4-8

# ---- OpenAI -------------------------------------------------
# Get a key: https://platform.openai.com/
#OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini)
#OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway
#OPENAI_BASE_URL=

# ---- Google (Gemini) ---------------------------------------
# Get a key: https://aistudio.google.com/
#GOOGLE_API_KEY=AIza...
# (GEMINI_API_KEY is accepted as an alias)
# Optional model override (default: gemini-2.0-flash)
#GOOGLE_MODEL=gemini-2.0-flash

# ---- Companion tuning --------------------------------------
# Override the cat persona system prompt.
#AI_SYSTEM_PROMPT=
# Max tokens per reply (default: 1024)
#AI_MAX_TOKENS=1024
# Make the mock provider randomly fail 25% of the time, to demo
# the error/retry UI (default: false)
#AI_MOCK_SIMULATE_ERRORS=false

# ---- AI Companion Pet (/pet) --------------------------------
# WebSocket feed of real dev-environment events + world snapshots.
# Frames: {"event": DevEvent} and/or {"world": Partial<WorldSnapshot>}
# — see docs/COMPANION_PET.md. When unset, a rich mock simulator runs.
# Build-time variable: restart/rebuild after changing.
#NEXT_PUBLIC_PET_WS_URL=ws://localhost:8788/pet

# ---- Agent status feed (client-side) -----------------------
# WebSocket URL pushing frames shaped {"sessions": AgentSession[]}.
# When unset, a built-in simulator provides realistic mock sessions.
# NOTE: NEXT_PUBLIC_* vars are baked in at build time — restart/rebuild
# after changing this one.
#NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8787/agents
